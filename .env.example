# Copy to .env and generate a random owner credential: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
DATABASE_URL=postgresql+psycopg://understory:understory@127.0.0.1:54329/understory
API_PORT=8017
OWNER_TOKEN=
ALLOWED_REPOSITORIES=understory/fixture
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# lexical works without any model downloads; fastembed enables local semantic retrieval.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MODEL_CACHE_DIR=.cache/models
# Groq is optional. Never put this value in frontend configuration.
GENERATION_PROVIDER=disabled
GENERATION_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# Maximum reserved generation tokens per UTC day; zero disables external generation.
DAILY_TOKEN_BUDGET=0
GITHUB_TOKEN=
JOB_LEASE_SECONDS=60
HEARTBEAT_SECONDS=15
STORAGE_LIMIT_BYTES=536870912
